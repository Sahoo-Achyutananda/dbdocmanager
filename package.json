{
  "name": "dbdocmanager_ssd",
  "version": "1.0.1",
  "description": "Database documentation and lineage tool using a JSON-based DSL. Generate beautiful docs, ER diagrams, and data lineage graphs.",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sahoo-Achyutananda/dbdocmanager.git"
  },
  "author": "SSD Group 3",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Sahoo-Achyutananda/dbdocmanager/issues"
  },
  "homepage": "https://github.com/Sahoo-Achyutananda/dbdocmanager#readme",
  "keywords": [
    "database",
    "documentation",
    "lineage",
    "data-catalog",
    "data-engineering",
    "schema",
    "erd",
    "data-dictionary",
    "metadata",
    "dsl",
    "nosql",
    "mongodb",
    "postgres",
    "mysql",
    "snowflake"
  ],
  "bin": {
    "dbdoc": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "validate": "ts-node src/cli.ts validate",
    "generate": "ts-node src/cli.ts generate",
    "test": "ts-node src/cli.ts validate examples/sample-schema.json && ts-node src/cli.ts generate examples/sample-schema.json -o ./output"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "@types/node": "^24.7.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.1"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
